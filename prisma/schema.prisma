// Schema do painel admin (dono das migrations).
// Gerador clássico para bater com o projeto do bot (import de '@prisma/client').

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id           String   @id @default(uuid())
  nome         String
  telefone     String   @unique
  email        String?
  notas        String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  segmentoId String?
  segmento   Segmento? @relation(fields: [segmentoId], references: [id], onDelete: SetNull)

  @@map("clientes")
}

model Segmento {
  id       String    @id @default(uuid())
  nome     String    @unique
  criadoEm DateTime  @default(now())
  clientes Cliente[]

  @@map("segmentos")
}

model Categoria {
  id       String    @id @default(uuid())
  nome     String
  ordem    Int       @default(0)
  criadoEm DateTime  @default(now())
  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id           String    @id @default(uuid())
  nome         String
  descricao    String?
  preco        Decimal   @db.Decimal(10, 2)
  imagemUrl    String?
  ativo        Boolean   @default(true)
  categoriaId  String
  categoria    Categoria @relation(fields: [categoriaId], references: [id])
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@map("produtos")
}

model Campanha {
  id           String    @id @default(uuid())
  titulo       String
  mensagem     String
  imagemUrl    String?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  disparos     Disparo[]

  @@map("campanhas")
}

model Disparo {
  id          String    @id @default(uuid())
  mensagem    String
  imagemUrl   String?
  status      String    @default("pendente") // pendente | enviando | concluido | erro
  total       Int       @default(0)
  enviados    Int       @default(0)
  falhas      Int       @default(0)
  erro        String?
  destinatarios    String[] @default([])
  descricaoDestino String?
  campanhaId  String?
  campanha    Campanha? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)
  criadoEm    DateTime  @default(now())
  iniciadoEm  DateTime?
  concluidoEm DateTime?

  @@map("disparos")
}

model BotStatus {
  id           String   @id
  estado       String   @default("desconectado") // desconectado | qr | conectado
  qr           String?
  atualizadoEm DateTime @updatedAt

  @@map("bot_status")
}
